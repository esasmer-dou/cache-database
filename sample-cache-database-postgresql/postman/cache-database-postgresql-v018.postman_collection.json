{
  "info": {
    "name": "CacheDB postgresql 0.18 controls",
    "description": "Run against owned demo fixtures only. Known demo tokens are NOT production credentials. Demonstrates explicit Redis/SQL routes and bounded 0.18 controls; no latency SLA or global SQL-history totals.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [{"listen":"test","script":{"type":"text/javascript","exec":["if (pm.info.requestName === '12 Move composite membership' && pm.response.code === 202) pm.collectionVariables.set('offerToken',pm.response.json().causalToken);"]}}],
  "variable": [
    {"key":"peerBaseUrl","value":"http://127.0.0.1:8091"},
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8091"
    },
    {
      "key": "supplierToken",
      "value": "demo-supplier"
    },
    {
      "key": "tenantAToken",
      "value": "demo-shop-a"
    },
    {
      "key": "tenantBToken",
      "value": "demo-shop-b"
    }
  ],
  "item": [
    {
      "name": "01 Reject missing identity",
      "request": {
        "method": "GET",
        "header": [],
