      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 202', () => pm.response.to.have.status(202));",
              "pm.test('Redis receipt is not SQL commit', () => { pm.expect(pm.response.json().redisAccepted).to.eql(true); pm.expect(pm.response.json().sqlDurabilityConfirmed).to.eql(false); });",
              "pm.collectionVariables.set('offerToken',pm.response.json().causalToken);"
            ]
          }
        }
      ]
