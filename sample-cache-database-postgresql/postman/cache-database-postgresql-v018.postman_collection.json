    {
      "name": "18 Wait for supplier warm",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/warm/jobs/{{controlsWarmJobId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "const r=pm.response.json(), n=Number(pm.collectionVariables.get('warmAttempts')||0)+1;pm.collectionVariables.set('warmAttempts',n);",
              "if (!['COMPLETED','FAILED'].includes(r.status) && n<150 && Date.now()<Number(pm.collectionVariables.get('warmDeadline'))) { setTimeout(()=>pm.execution.setNextRequest(pm.info.requestName),200); } else { pm.test('Warm completed',()=>pm.expect(r.status).to.eql('COMPLETED')); pm.execution.setNextRequest('20 Reject unbounded warm'); }"
            ]
          }
        }
      ]
