        ],
        "url": "{{baseUrl}}/api/examples/v018/offers/9600001",
        "body": {
          "mode": "raw",
          "raw": "{\"supplier\":\"postman-window\",\"status\":\"ACTIVE\",\"unitPrice\":12.125,\"availableUnits\":20}",
          "options": {
            "raw": {
              "language": "json"
            }
