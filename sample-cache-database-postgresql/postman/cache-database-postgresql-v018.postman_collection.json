              "const ready=pm.response.code===200 && pm.response.json().availableUnits===77, n=Number(pm.collectionVariables.get('sqlAttempts')||0)+1;pm.collectionVariables.set('sqlAttempts',n);",
              "if (!ready && n<150 && Date.now()<Number(pm.collectionVariables.get('sqlDeadline'))) { setTimeout(()=>pm.execution.setNextRequest(pm.info.requestName),200); } else { pm.test('Durable source reflects PATCH',()=>pm.expect(ready).to.eql(true)); pm.execution.setNextRequest('17 Explicit bounded supplier warm'); }"
            ]
