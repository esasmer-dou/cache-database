        "url": "{{baseUrl}}/api/examples/v019/range-data/{{rangeRun}}/native?limit=2&cursor={{rangeCursor}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Exact ordered slots', function () { pm.expect(pm.response.json().items.map(r => r.slot)).to.eql([\"a0\",\"d\"]); });",
              "pm.test('Exact full-width Long continuation', function () { const b=pm.response.json(); pm.expect(b.items.map(r=>r.rank)).to.eql(['9007199254740993','9223372036854775807']); pm.expect(b.nextCursor).to.eql(null); });"
            ]
          }
        }
      ]
    },
