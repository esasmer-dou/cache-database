    {
      "name": "Range Data - Native Composite Range Keyset First",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{cacheTenantAToken}}",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/api/examples/v019/range-data/{{rangeRun}}/native?limit=2"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Exact ordered slots', function () { pm.expect(pm.response.json().items.map(r => r.slot)).to.eql([\"a\",\"b\"]); });",
              "pm.test('Long values and residency contract', function () { const b=pm.response.json(); pm.expect(b.items.map(r=>r.rank)).to.eql(['9007199254740992','9007199254740992']); pm.expect(b.sourceCoverageConfirmed).to.be.a('boolean'); pm.expect(b.nextCursor).to.be.a('string').and.not.empty; });",
              "pm.collectionVariables.set('rangeCursor', pm.response.json().nextCursor);"
            ]
          }
        }
      ]
    },
    {
      "name": "Range Data - Native Lexical Continuation",
      "request": {
        "method": "GET",
        "header": [
