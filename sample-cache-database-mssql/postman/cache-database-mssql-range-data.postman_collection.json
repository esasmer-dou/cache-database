{
  "info": {
    "name": "CacheDB mssql Range and Spring Data",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Disposable demo: exact signed Long range/keyset, Spring Data CRUD/Page/Slice/Window, verified tenant and causal rejection. Redis-resident results, not a source snapshot."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8092"
    },
    {
      "key": "rangeDataEnabled",
      "value": "false"
    },
    {
      "key": "rangeDataCertification",
      "value": "false"
    },
    {
      "key": "cacheSupplierToken",
      "value": "demo-supplier"
    },
    {
      "key": "cacheTenantAToken",
      "value": "demo-shop-a"
    },
    {
      "key": "cacheTenantBToken",
      "value": "demo-shop-b"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const enabled = String(pm.variables.get('rangeDataEnabled')) === 'true';",
          "const required = String(pm.variables.get('rangeDataCertification')) === 'true';",
          "if (!enabled && required) { throw new Error('rangeDataEnabled=true is required for certification'); }",
          "if (!enabled) { pm.execution.skipRequest(); }"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Range Data - Save Tenant A a",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{cacheTenantAToken}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/api/examples/v019/range-data/{{rangeRun}}/rows/a",
        "body": {
          "mode": "raw",
          "raw": "{\"rank\":\"9007199254740992\",\"status\":\"OPEN\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('rangeRun', pm.variables.replaceIn('{{$randomUUID}}').replace(/-/g, ''));",
              "['rangeCursor','dataCursor'].forEach(k => pm.collectionVariables.unset(k));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 202', function () { pm.response.to.have.status(202); });",
              "pm.test('Exact accepted row without SQL promise', function () { const b=pm.response.json(); pm.expect(b.row.rank).to.eql('9007199254740992'); pm.expect(b.row.tenant).to.eql('shop-a'); pm.expect(b.sqlDurabilityConfirmed).to.eql(false); pm.expect(pm.response.headers.has('X-CacheDB-Causal')).to.eql(false); });"
            ]
          }
        }
      ]
    },
