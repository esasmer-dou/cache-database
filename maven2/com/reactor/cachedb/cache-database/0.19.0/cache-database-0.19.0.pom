<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.reactor.cachedb</groupId>
    <artifactId>cache-database</artifactId>
    <version>0.19.0</version>
    <packaging>pom</packaging>

    <name>cache-database</name>
    <description>Redis-first Java data layer with bounded hot sets, projections, compile-time generated APIs, and durable SQL write-behind</description>
    <url>${cachedb.release.projectUrl}</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>${cachedb.release.developerId}</id>
            <name>${cachedb.release.developerName}</name>
            <organization>${cachedb.release.developerOrganization}</organization>
            <organizationUrl>${cachedb.release.projectUrl}</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>${cachedb.release.scmConnection}</connection>
        <developerConnection>${cachedb.release.scmDeveloperConnection}</developerConnection>
        <url>${cachedb.release.projectUrl}</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>${cachedb.release.issueUrl}</url>
    </issueManagement>

    <ciManagement>
        <system>GitHub Actions</system>
        <url>${cachedb.release.ciUrl}</url>
    </ciManagement>

    <properties>
        <cachedb.gson.version>2.13.2</cachedb.gson.version>
        <maven.compiler.release>21</maven.compiler.release>
        <maven.compiler.proc>full</maven.compiler.proc>
        <argLine/>
        <cachedb.test.jvmArgs/>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jedis.version>5.2.0</jedis.version>
        <postgresql.version>42.7.4</postgresql.version>
        <mssql.jdbc.version>12.8.1.jre11</mssql.jdbc.version>
        <oracle.jdbc.version>23.26.1.0.0</oracle.jdbc.version>
        <spring.boot.version>3.3.5</spring.boot.version>
        <micrometer.version>1.13.6</micrometer.version>
        <maven.source.plugin.version>3.3.1</maven.source.plugin.version>
        <maven.javadoc.plugin.version>3.7.0</maven.javadoc.plugin.version>
        <maven.gpg.plugin.version>3.2.4</maven.gpg.plugin.version>
        <maven.deploy.plugin.version>3.1.2</maven.deploy.plugin.version>
        <central.publishing.maven.plugin.version>0.7.0</central.publishing.maven.plugin.version>
        <gpg.skip>true</gpg.skip>
        <cachedb.release.projectUrl>https://github.com/esasmer-dou/cache-database</cachedb.release.projectUrl>
        <cachedb.release.scmConnection>scm:git:https://github.com/esasmer-dou/cache-database.git</cachedb.release.scmConnection>
        <cachedb.release.scmDeveloperConnection>scm:git:git@github.com:esasmer-dou/cache-database.git</cachedb.release.scmDeveloperConnection>
        <cachedb.release.issueUrl>https://github.com/esasmer-dou/cache-database/issues</cachedb.release.issueUrl>
        <cachedb.release.ciUrl>https://github.com/esasmer-dou/cache-database/actions</cachedb.release.ciUrl>
        <cachedb.release.developerId>esasmer-dou</cachedb.release.developerId>
        <cachedb.release.developerName>esasmer-dou</cachedb.release.developerName>
        <cachedb.release.developerOrganization>esasmer-dou</cachedb.release.developerOrganization>
    </properties>

    <modules>
        <module>cachedb-annotations</module>
        <module>cachedb-processor</module>
        <module>cachedb-core</module>
        <module>cachedb-json</module>
        <module>cachedb-storage-redis</module>
        <module>cachedb-storage-jdbc</module>
        <module>cachedb-storage-postgres</module>
        <module>cachedb-storage-mssql</module>
        <module>cachedb-storage-oracle</module>
        <module>cachedb-starter</module>
        <module>cachedb-spring-boot-starter</module>
        <module>cachedb-reactor</module>
        <module>cachedb-spring-data</module>
        <module>cachedb-spring-boot-starter-postgres</module>
        <module>cachedb-spring-boot-starter-mssql</module>
        <module>cachedb-spring-boot-starter-oracle</module>
        <module>cachedb-spring-boot-starter-admin</module>
        <module>cachedb-spring-boot-test</module>
        <module>cachedb-bom</module>
        <module>cachedb-maven-plugin</module>
        <module>cachedb-migration-recipes</module>
        <module>cachedb-examples</module>
        <module>cachedb-integration-tests</module>
        <module>cachedb-production-tests</module>
    </modules>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <proc>full</proc>
                        <!-- Generated sibling sources are deliberately compiled with their callers. -->
                        <implicit>class</implicit>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>${maven.source.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                    <configuration>
                        <argLine>${argLine} ${cachedb.test.jvmArgs}</argLine>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>${maven.javadoc.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-gpg-plugin</artifactId>
                    <version>${maven.gpg.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>${maven.deploy.plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>require-supported-build-platform</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                    <message>CacheDB requires Java 21 or newer. Java 17 applications must stay on CacheDB 0.18.x.</message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                    <message>CacheDB builds require Maven 3.9 or newer.</message>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>virtual-thread-readiness</id>
            <properties>
                <cachedb.test.jvmArgs>-Xlog:jfr+startup=off -XX:FlightRecorderOptions=stackdepth=256 -XX:StartFlightRecording=settings=${maven.multiModuleProjectDirectory}/tools/ci/virtual-threads.jfc,filename=${project.build.directory}/virtual-threads-${surefire.forkNumber}.jfr,dumponexit=true,maxsize=64m</cachedb.test.jvmArgs>
            </properties>
        </profile>
        <profile>
            <id>inmemory-benchmarks</id>
            <modules>
                <module>tools/benchmarks/inmemory</module>
            </modules>
        </profile>
        <profile>
            <id>redis-benchmarks</id>
            <modules>
                <module>tools/benchmarks/redis</module>
            </modules>
        </profile>
        <profile>
            <id>oss-release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                                <configuration>
                                    <source>${maven.compiler.release}</source>
                                    <sourcepath>${project.build.sourceDirectory}${path.separator}${project.build.directory}/generated-sources/annotations</sourcepath>
                                    <show>package</show>
                                    <failOnError>false</failOnError>
                                    <doclint>none</doclint>
                                    <sourceFileIncludes>
                                        <sourceFileInclude>**/*.java</sourceFileInclude>
                                    </sourceFileIncludes>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                                <configuration>
                                    <skip>${gpg.skip}</skip>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${central.publishing.maven.plugin.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <waitUntil>published</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
