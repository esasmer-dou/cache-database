{
  "schema": 1,
  "evidence": "STATIC_CONTRACT_ONLY_NOT_RUNTIME_ACCEPTANCE",
  "providers": [
    "postgresql",
    "mssql",
    "oracle"
  ],
  "scenarios": [
    {
      "id": "audit-write",
      "method": "sourceRoundtrip",
      "request": "Expire delete 1",
      "calls": [
        "AuditNoteRules.verify",
        "write"
      ],
      "extra": [
        [
          "write",
          [
            "stores.delete",
            "stores.evict",
            "saveWithReceipt",
            "confirm",
            "findById"
          ]
        ],
        [
          "confirm",
          [
            "awaitDurable"
          ]
        ]
      ],
      "test": "acceptedWriteTimeoutIsNotRetriedAndNeverClaimsSourceConfirmation",
      "external": "evictSweepsOnlyIndexedExpiredPayloadAndRetainsDurableSql"
    },
    {
      "id": "spring-data-zero-query-budget",
      "method": "springData",
      "request": "Spring Data rejects zero query budget",
      "calls": [
        "AuditNoteRules.verify",
        "entityQueryCapacity",
        "deleteByState",
        "partial"
      ],
      "extra": [],
      "test": "derivedPartialFailurePreservesAllCategoriesWithoutRetry",
      "external": "derivedDeleteRejectsZeroQueryBudgetWithoutMutatingAnyRows"
    },
    {
      "id": "native-bulk-receipts",
      "method": "bulk",
      "request": "Native bulk returns actual receipts",
      "calls": [
        "AuditNoteRules.verify",
        "AuditNoteRules.ids",
        "bulkDelete",
        "partial"
      ],
      "extra": [],
      "test": "nativeBulkExposesActualReceiptsAndBoundsBeforeIo",
      "external": "actualBulkHttpReceiptsConfirmOnlyRedisUntilMatchingSqlMarkersAreAwaited"
    },
    {
      "id": "retention-evict",
      "method": "sweep",
      "request": "Evict indexed expired cache payload",
      "calls": [
        "AuditNoteRules.verify",
        "AuditNoteRules.maxRows",
        "CacheTenantContext.administrative",
        "sweepOnce"
      ],
      "extra": [],
      "test": "sweeperUsesActualAdministrativeScopeAndRestoresCallerOnBothPaths",
      "external": "evictSweepsOnlyIndexedExpiredPayloadAndRetainsDurableSql"
    },
    {
      "id": "retention-delete",
      "method": "sweep",
      "request": "Delete indexed expired note via write-behind",
      "calls": [
        "AuditNoteRules.verify",
        "AuditNoteRules.maxRows",
        "CacheTenantContext.administrative",
        "sweepOnce"
      ],
      "extra": [],
      "test": "sweeperUsesActualAdministrativeScopeAndRestoresCallerOnBothPaths",
      "external": "deleteSweepEnqueuesNormalWriteBehindWithoutClaimingSourceErasure"
    },
    {
      "id": "supplier-tenant-causal",
      "method": "source",
      "request": "Tenant A cannot inspect global source",
      "calls": [
        "AuditNoteRules.verify",
        "findById"
      ],
      "extra": [],
      "test": "supplierTenantAndCausalGuardsFailBeforeAnyRepositoryMutation",
      "external": "actualHttpRejectsTenantIdentityCausalRequirementsAndOutOfBoundsSweep"
    }
  ],
