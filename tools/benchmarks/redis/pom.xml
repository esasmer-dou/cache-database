<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.reactor.cachedb</groupId>
        <artifactId>cache-database</artifactId>
        <version>0.19.0</version>
        <relativePath>../../../pom.xml</relativePath>
    </parent>
    <artifactId>cachedb-benchmarks-redis</artifactId>
    <name>CacheDB Redis Benchmarks (Development Tool)</name>
    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <maven.install.skip>true</maven.install.skip>
        <maven.deploy.skip>true</maven.deploy.skip>
        <cachedb.benchmark.runtime.version>${project.version}</cachedb.benchmark.runtime.version>
        <cachedb.benchmark.shaded.name>benchmarks</cachedb.benchmark.shaded.name>
        <cachedb.benchmark.main.class>com.reactor.cachedb.benchmarks.redis.RedisBenchmarkRunner</cachedb.benchmark.main.class>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.reactor.cachedb</groupId>
            <artifactId>cachedb-starter</artifactId>
            <version>${cachedb.benchmark.runtime.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <version>1.37</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.16</version>
            <scope>runtime</scope>
        </dependency>
    </dependencies>
    <repositories>
        <repository>
            <id>cachedb-public-maven</id>
            <url>https://esasmer-dou.github.io/cache-database/maven2</url>
        </repository>
    </repositories>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.openjdk.jmh</groupId>
                            <artifactId>jmh-generator-annprocess</artifactId>
                            <version>1.37</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <finalName>${cachedb.benchmark.shaded.name}</finalName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${cachedb.benchmark.main.class}</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/versions/**/module-info.class</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!-- Explicit new-API capability build; no activation and no change to the legacy source set. -->
        <profile>
            <id>redis-benchmarks-t1</id>
            <properties>
                <cachedb.benchmark.shaded.name>benchmarks-t1-coalescing</cachedb.benchmark.shaded.name>
                <cachedb.benchmark.main.class>org.openjdk.jmh.Main</cachedb.benchmark.main.class>
            </properties>
            <build>
                <directory>${project.basedir}/target/coalescing</directory>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.6.2</version>
                        <executions>
                            <execution>
                                <id>redis-benchmarks-t1-source</id>
                                <phase>generate-sources</phase>
                                <goals><goal>add-source</goal></goals>
                                <configuration>
                                    <sources><source>${project.basedir}/src/coalescing/java</source></sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>redis-benchmarks-v019</id>
            <properties>
                <cachedb.benchmark.shaded.name>benchmarks-v019-features</cachedb.benchmark.shaded.name>
                <cachedb.benchmark.main.class>org.openjdk.jmh.Main</cachedb.benchmark.main.class>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>com.reactor.cachedb</groupId>
                    <artifactId>cachedb-spring-boot-starter</artifactId>
                    <version>${cachedb.benchmark.runtime.version}</version>
                </dependency>
                <dependency>
                    <groupId>io.micrometer</groupId>
                    <artifactId>micrometer-observation</artifactId>
                    <version>${micrometer.version}</version>
                </dependency>
            </dependencies>
            <build>
                <directory>${project.basedir}/target/features-v019</directory>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.6.2</version>
                        <executions>
                            <execution>
                                <id>redis-benchmarks-v019-sources</id>
                                <phase>generate-sources</phase>
                                <goals><goal>add-source</goal></goals>
                                <configuration>
                                    <sources>
                                        <source>${project.basedir}/src/coalescing/java</source>
                                        <source>${project.basedir}/src/features/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
